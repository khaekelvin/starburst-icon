{
  "name": "starburst-icon",
  "bin": {
    "starburst-icon": "dist/cli/index.js"
  },
  "version": "0.1.0",
  "description": "Cute expressive starburst characters as React SVG components — 18 emotions, zero dependencies",
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/yourusername/starburst#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khaekelvin/starburst-icon",
    "directory": "packages/starburst"
  },
  "keywords": [
    "avatar",
    "svg",
    "characters",
    "vector",
    "cute",
    "starburst"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.3",
    "picocolors": "^1.1.1",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
